[Unit]
Description=ISS Spotter Flask Web App
After=network.target

[Service]
Type=simple
User=exouser
Group=exouser
WorkingDirectory=/opt/iss-spotter/repo
ExecStart=/opt/iss-spotter/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --access-logfile - \
    app.server:app
Restart=always
RestartSec=5
Environment="PATH=/opt/iss-spotter/venv/bin:/usr/bin"

[Install]
WantedBy=multi-user.target